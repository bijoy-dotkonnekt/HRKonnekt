# External agents (one endpoint each). Leave empty to use the offline stub agents.
HR_AGENT_URL=
BONDING_AGENT_URL=
WELLNESS_AGENT_URL=
# Kompass (Sangria AI Studio) headers sent with every agent call
KOMPASS_TENANT_ID=
KOMPASS_PROJECT_ID=
AGENT_TIMEOUT=60
FORCE_OFFLINE=0
# Base URL the offline stub agents call. Kompass tools use their own full URLs (<tunnel>/api/tools/...)
PUBLIC_API_BASE_URL=http://localhost:8000/api/me
HRMS_BASE_URL=http://localhost:8000/hrms

# Password every employee account starts with (sign-in for KonnektHRMS + HRKonnekt)
DEMO_PASSWORD=demo
